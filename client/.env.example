# Backend API Base URL for Vite frontend
# Local Development: Leave empty to use Vite dev server proxy (http://localhost:5000), or set explicitly:
# VITE_API_URL=http://localhost:5000
#
# Production (set this in your Vercel Project Settings -> Environment Variables):
# Set this to your deployed Render backend service URL.
# Example: https://your-backend-app.onrender.com (do NOT set this to your frontend vercel.app URL)
VITE_API_URL=https://your-backend-app.onrender.com
