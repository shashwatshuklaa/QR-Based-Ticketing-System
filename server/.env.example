MONGO_URI=mongodb://localhost:27017/qr-ticketing
PORT=5000
JWT_SECRET=your_jwt_secret_key_here
# Client origin for CORS allowance (comma-separated list for multiple origins)
# In local development: http://localhost:3000
# In production on Render: https://qr-based-ticketing-system-di2m.vercel.app
CLIENT_URL=https://qr-based-ticketing-system-di2m.vercel.app
NODE_ENV=development

# Razorpay Test Mode Configuration
# Obtain your test credentials from Razorpay Dashboard: Settings -> API Keys (Generate Test Key)
# If omitted or left empty, the application runs in local simulated test mode.
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# Optional: Email Service Credentials (If omitted, tickets and OTPs are logged to console)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_password_or_app_password

# Note: Administrator accounts should NOT have passwords stored in .env.
# Run 'npm run create-admin' to create admin and super-admin accounts interactively.
