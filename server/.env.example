MONGO_URI=mongodb://localhost:27017/qr-ticketing
PORT=5000
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:3000

# Optional: Razorpay Test Mode Keys (If omitted, app runs in simulated test mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: Email Service Credentials (If omitted, tickets and OTPs are logged to console)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# Note: Administrator accounts should NOT have passwords stored in .env.
# Run 'npm run create-admin' to create admin and super-admin accounts interactively.
